--- a/oscar/mainwindow.cpp
+++ b/oscar/mainwindow.cpp
@@ -521,6 +521,14 @@ bool MainWindow::OpenProfile(QString profileName)
     p_profile = prof;
     ProgressDialog * progress = new ProgressDialog(this);
 
+    // On Wayland the main window must commit at least one buffer before any
+    // transient dialog is shown; otherwise the compositor never maps the main
+    // window surface (it stays bufferless while the dialog completes the
+    // startup-notification handshake on its behalf).  Force a repaint here so
+    // the backing-store buffer is flushed before the progress dialog opens.
+    repaint();
+    QApplication::processEvents(QEventLoop::ExcludeUserInputEvents);
+
     progress->setMessage(QObject::tr("Loading profile \"%1\"...").arg(profileName));
     progress->open();
 
