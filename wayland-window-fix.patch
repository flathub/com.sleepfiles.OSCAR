--- a/oscar/mainwindow.cpp
+++ b/oscar/mainwindow.cpp
@@ -101,9 +101,14 @@ MainWindow::MainWindow(QWidget *parent) :
         logger->connectionReady();
     }
 
-    // Bring window to top (useful when language is changed)
-    this->activateWindow();
-    this->raise();
+    // Bring window to top (useful when language is changed).
+    // Only do this if the window is already visible; calling activateWindow()
+    // before show() is a no-op on X11 and can prevent the compositor from
+    // mapping the window on Wayland (XDG activation token not yet available).
+    if (isVisible()) {
+        this->activateWindow();
+        this->raise();
+    }
 
     // Initialise oscar app registry stuff
     QSettings settings;
--- a/oscar/main.cpp
+++ b/oscar/main.cpp
@@ -786,6 +786,15 @@ int main(int argc, char *argv[])
     mainwin->SetupGUI();
     sc.check();
     mainwin->show();
+    // On Wayland (especially GNOME), show() alone is not enough to raise the
+    // main window — the compositor requires an explicit activation request after
+    // the window surface has been created.  Queue raise()+activateWindow() so
+    // they run on the first event-loop iteration, by which point the Wayland
+    // surface exists and an XDG activation token can be obtained.
+    QTimer::singleShot(0, mainwin, []() {
+        mainwin->raise();
+        mainwin->activateWindow();
+    });
 
     int result = mainapp.exec();
 
